---
import { site, waTo } from '../data/site.js';

---
<p class="eyebrow">Contatti</p>
<h2>Siamo a disposizione</h2>
<div class="contact-grid">
  <div class="card contact-card">
    <ul class="contact-list">
      {site.people.map((p) => (
        <li>
          <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" /><path d="M9 10h.01M12 10h.01M15 10h.01" /></svg>{p.name}</span>
          <span class="contact-person">
            <a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a>
            <a class="contact-wa" href={waTo(p.phone, `Ciao ${p.name}!`)} target="_blank" rel="noopener">WhatsApp</a>
          </span>
        </li>
      ))}
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>Email</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>Instagram</span>
        <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">@{site.instagram}</a>
      </li>
    </ul>
  </div>
  <div class="card hours">
    <h3>Orari di apertura</h3>
    <table>
      {site.hours.map(([d, h]) => <tr><th>{d}</th><td>{h}</td></tr>)}
      <tr><th>Zona</th><td>{site.area}</td></tr>
    </table>
  </div>
</div>
