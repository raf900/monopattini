---
import { site, wa } from '../data/site.js';

---
<p class="eyebrow">Contatti</p>
<h2>Siamo a disposizione</h2>
<div class="contact-grid">
  <div class="card contact-card">
    <ul class="contact-list">
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>Telefono</span>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
      </li>
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" /><path d="M9 10h.01M12 10h.01M15 10h.01" /></svg>WhatsApp</span>
        <a href={wa('Ciao!')}>Clicca per scrivere</a>
      </li>
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>Email</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <span><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>Instagram</span>
        <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">@{site.instagram}</a>
      </li>
    </ul>
  </div>
  <div class="card hours">
    <h3>Orari di apertura</h3>
    <table>
      {site.hours.map(([d, h]) => <tr><th>{d}</th><td>{h}</td></tr>)}
    </table>
  </div>
</div>
