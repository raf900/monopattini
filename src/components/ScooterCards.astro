---
import { Image } from 'astro:assets';
import ScooterMark from './ScooterMark.astro';
import { scooters, tuttiAds, statusLabel, chf } from '../data/site.js';
import { photo } from '../data/photos.js';

// exclude: slug da non mostrare (es. il monopattino della pagina corrente)
// famiglia: mostra solo i monopattini con la stessa struttura (pagina del monopattino)
// onlyAvailable: mostra solo quelli 'disponibile' (usato in home)
// sortable: mostra "Ordina per" e i filtri a cursore (pagina Usato)
// withTutti: aggiunge in fondo le card degli annunci di privati su tutti.ch (si aprono su tutti.ch)
const { exclude, famiglia, onlyAvailable = false, sortable = false, withTutti = false } = Astro.props;
const tutti = withTutti ? tuttiAds : [];
// numero dalla velocità su strade private ("45 km/h" → 45); se manca, quella legale
const topSpeed = (s) => parseInt(s.velocitaMax) || s.velocita || 0;
// grandezza ruote dalla scheda tecnica ('8,5" con camera d’aria' → 8.5)
const wheel = (s) => parseFloat((s.specs?.find(([k]) => k === 'Pneumatici')?.[1] ?? '').replace(',', '.')) || '';
// autonomia dichiarata dalla scheda tecnica ('45 km' → 45)
const autonomy = (s) => parseInt(s.specs?.find(([k]) => k === 'Autonomia dichiarata')?.[1] ?? '') || '';
const list = scooters.filter((s) => s.slug !== exclude && (!famiglia || s.famiglia === famiglia) && (!onlyAvailable || s.status === 'disponibile'));

// Filtri a cursore: min e max presi dai monopattini in elenco (un filtro senza differenze non viene mostrato)
const values = (fn) => list.map(fn).filter((v) => typeof v === 'number' && !isNaN(v));
const prices = [...values((s) => s.price), ...tutti.map((a) => a.price)];
const filters = [
  { key: 'price', label: 'Prezzo', fmt: (v) => `CHF ${v}`, step: 10, vals: prices },
  { key: 'year', label: 'Anno', fmt: (v) => `${v}`, step: 1, vals: values((s) => s.year) },
  { key: 'km', label: 'Km percorsi', fmt: (v) => `${v.toLocaleString('de-CH')} km`, step: 50, vals: values((s) => s.km) },
]
  // estremi arrotondati al passo del cursore, così nessun monopattino resta escluso all'apertura
  .map((f) => ({ ...f, min: Math.floor(Math.min(...f.vals) / f.step) * f.step, max: Math.ceil(Math.max(...f.vals) / f.step) * f.step }))
  .filter((f) => f.vals.length && f.min < f.max);
// Filtri a etichette (pochi valori possibili): si possono scegliere più valori; nessuno scelto = tutti
const chipFilters = [
  { key: 'autonomia', label: 'Autonomia', fmt: (v) => `${v} km`, vals: values(autonomy) },
  { key: 'speed', label: 'Velocità', fmt: (v) => `${v} km/h`, vals: values(topSpeed) },
  { key: 'wheel', label: 'Ruote', fmt: (v) => `${String(v).replace('.', ',')}"`, vals: values(wheel) },
]
  .map((f) => ({ ...f, opts: [...new Set(f.vals)].sort((a, b) => a - b) }))
  .filter((f) => f.opts.length > 1);
// Modelli: nome ridotto al modello base ('Xiaomi Mi Pro 2' → 'Pro 2'); 'Pro / Pro 2' vale per entrambi
const modelOrder = ['Essential', '1S', 'Pro', 'Pro 2', 'Pro 3', '4 Pro', '5', 'Ninebot'];
const modelsOf = (name) => {
  const n = name.replace(/\(.*?\)|\bx\d+\b|\bCH\b|\bXiaomi\b|\bMi\b/g, ' ').replace(/\s+/g, ' ').trim();
  return n.split(/\s*(?:\/|\bo\b)\s*/).map((m) => m.trim()).filter((m) => modelOrder.includes(m));
};
// Annunci tutti.ch: autonomia, velocità e ruote stimate da un nostro monopattino dello stesso modello
// ('Pro / Pro 2' → Pro; il Pro 3 è uguale al Pro 2; i Ninebot restano senza dati)
const sameAs = { 'Pro 3': 'Pro 2' };
const like = (a) => { let m = modelsOf(a.model)[0]; m = sameAs[m] ?? m; return m && scooters.find((s) => modelsOf(s.model)[0] === m); };
const allModels =[...list.map((s) => modelsOf(s.model)), ...tutti.map((a) => modelsOf(a.model))];
const modelChips = modelOrder
  .map((m) => ({ m, n: allModels.filter((ms) => ms.includes(m)).length }))
  .filter((c) => c.n > 0);
const fmts = Object.fromEntries(filters.map((f) => [f.key, f.fmt(1).replace('1', '#')]));
---
{list.length === 0 && <p class="sub">Al momento non ci sono monopattini disponibili. <a href="/usato">Guarda quelli in arrivo</a>.</p>}
<div class:list={[sortable && list.length > 1 && 'shop']}>
  {sortable && list.length > 1 && (
    <div class="sort-bar">
      <button type="button" class="filters-toggle" aria-controls="filtri" aria-expanded="false" data-filters-toggle>Filtri</button>
      <span class="sort-count" data-count>{list.length + tutti.length} monopattini</span>
      <button type="button" class="cmp-toggle" aria-pressed="false" data-cmp-toggle>⇄ Confronta</button>
      <label for="sort">Ordina per</label>
      <select id="sort" data-sort>
        <option value="price-asc">Prezzo: più basso</option>
        <option value="price-desc">Prezzo: più alto</option>
        <option value="year-desc">Anno: più recente</option>
        <option value="year-asc">Anno: meno recente</option>
        <option value="score-desc">Punteggio</option>
        <option value="km-asc">Meno km percorsi</option>
        <option value="speed-desc">Velocità: più veloce</option>
      </select>
    </div>
  )}
  {sortable && list.length > 1 && (
    <aside class="card filters" id="filtri" data-filters data-fmts={JSON.stringify(fmts)}>
      <div class="filters-head">
        <h2>Filtri</h2>
        <button type="button" class="filters-reset" data-reset>Azzera</button>
      </div>
      {tutti.length > 0 && (
        <div class="range">
          <div class="range-top"><span>Venduti da</span></div>
          <div class="src-btns">
            <button type="button" aria-pressed="true" data-src="mine">Monopattini.ch</button>
            <button type="button" aria-pressed="true" data-src="tutti">tutti.ch</button>
          </div>
        </div>
      )}
      {modelChips.length > 1 && (
        <div class="range">
          <div class="range-top"><span>Modello</span></div>
          <div class="model-chips">
            {modelChips.map((c) => <button type="button" aria-pressed="false" data-model={c.m}>{c.m} <small>{c.n}</small></button>)}
          </div>
        </div>
      )}
      {filters.map((f) => (
        <div class="range" data-range={f.key}>
          <div class="range-top"><span>{f.label}</span><b data-out>{f.fmt(f.min)} – {f.fmt(f.max)}</b></div>
          <div class="range-track">
            <input type="range" min={f.min} max={f.max} step={f.step} value={f.min} data-lo aria-label={`${f.label} minimo`} />
            <input type="range" min={f.min} max={f.max} step={f.step} value={f.max} data-hi aria-label={`${f.label} massimo`} />
          </div>
        </div>
      ))}
      {chipFilters.map((f) => (
        <div class="range" data-chips={f.key}>
          <div class="range-top"><span>{f.label}</span></div>
          <div class="model-chips">
            {f.opts.map((v) => <button type="button" aria-pressed="false" data-val={v}>{f.fmt(v)}</button>)}
          </div>
        </div>
      ))}
    </aside>
  )}

  <div class="shop-main">
    <div class="grid grid-3" data-sort-grid>
      {list.map((s) => {
        const img = photo(s.photos?.[0]);
        const href = `/usato/${s.slug}`;
        return (
          <article class="card scooter" data-source="mine" data-models={modelsOf(s.model).join('|')} data-price={s.price ?? ''} data-year={s.year ?? ''} data-km={s.km ?? ''} data-speed={topSpeed(s)} data-wheel={wheel(s)} data-autonomia={autonomy(s)} data-score={s.punteggio?.totale ?? ''}>
            <a href={href} class:list={['scooter-img', img && 'has-photo', /\.(png|webp)$/.test(s.photos?.[0] ?? '') && 'cutout']} aria-label={s.model}>
              {img
                ? <Image src={img} alt={s.model} widths={[320, 640]} sizes="(max-width: 600px) 90vw, 340px" />
                : <ScooterMark />}
              {s.status && s.status !== 'disponibile' && <span class={`status status-${s.status}`}>{statusLabel[s.status]}</span>}
              {s.punteggio?.totale != null && (
                <span class="score-badge" title="Punteggio">
                  <span class="score-name"><ScooterMark class="score-mark" />SCORE</span>
                  <span class="score-val">{s.punteggio.totale.toLocaleString('it-CH')}<small>/10</small></span>
                </span>
              )}
            </a>
            {sortable && (
              <label class="cmp-pick"><input type="checkbox" data-cmp value={s.slug} /> Aggiungi al confronto</label>
            )}
            <h3><a href={href} class="scooter-link">{s.model}</a></h3>
            <ul class="specs">
              {s.year && <li><small>Anno</small> {s.year}</li>}
              {autonomy(s) && <li><small>Autonomia</small> {autonomy(s)} km</li>}
              {s.velocita && <li><small>Velocità</small> {s.velocita} km/h</li>}
            </ul>
            <div class="scooter-foot">
              <span class="big-price">{chf(s.price)}</span>
              <a class="btn btn-sm" href={href}>Dettagli</a>
            </div>
          </article>
        );
      })}
      {tutti.length > 0 && (
        <div class="tutti-sep" data-tutti-sep>
          <h2>Annunci di privati su tutti.ch</h2>
          <p>Monopattini venduti da privati: si aprono su tutti.ch.</p>
        </div>
      )}
      {tutti.map((a) => (
        <article class="card scooter tutti-card" data-source="tutti" data-models={modelsOf(a.model).join('|')} data-price={a.price} data-year="" data-km={a.km ?? ''} data-speed={like(a) ? topSpeed(like(a)) : ''} data-wheel={like(a) ? wheel(like(a)) : ''} data-autonomia={like(a) ? autonomy(like(a)) : ''} data-score="">
          <a href={a.url} target="_blank" rel="noopener" class:list={['scooter-img', a.img && 'has-photo tutti-photo']} aria-label={`${a.model} su tutti.ch`}>
            {a.img ? <img src={a.img} alt={a.model} loading="lazy" referrerpolicy="no-referrer" /> : <ScooterMark />}
          </a>
          <h3><a href={a.url} target="_blank" rel="noopener" class="scooter-link">{a.model}</a></h3>
          <ul class="specs">
            <li><small>Località</small> {a.loc}</li>
            {a.km != null && <li><small>Km</small> {a.km}</li>}
            <li><small>Venditore</small> Privato</li>
          </ul>
          <div class="scooter-foot">
            <span class="big-price">{chf(a.price)}</span>
            <a class="btn btn-sm btn-tutti" href={a.url} target="_blank" rel="noopener">su tutti.ch</a>
          </div>
        </article>
      ))}
    </div>
    {sortable && <p class="sub filters-empty" data-empty hidden>Nessun monopattino con questi filtri. <button type="button" class="filters-reset" data-reset>Azzera i filtri</button></p>}
  </div>
</div>

<script>
  const grid = document.querySelector<HTMLElement>('[data-sort-grid]');
  const sel = document.querySelector<HTMLSelectElement>('[data-sort]');
  const panel = document.querySelector<HTMLElement>('[data-filters]');

  if (grid && sel && panel) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.scooter')];
    const sep = grid.querySelector<HTMLElement>('[data-tutti-sep]');
    const num = (el: HTMLElement, k: string) => (el.dataset[k] === '' ? NaN : Number(el.dataset[k]));
    const fmts: Record<string, string> = JSON.parse(panel.dataset.fmts!);
    const show = (k: string, v: number) => fmts[k].replace('#', k === 'wheel' ? String(v).replace('.', ',') : k === 'km' ? v.toLocaleString('de-CH') : String(v));
    const ranges = [...panel.querySelectorAll<HTMLElement>('[data-range]')];
    const srcBtns = [...panel.querySelectorAll<HTMLButtonElement>('[data-src]')];
    // modelli: nessuno scelto = tutti; più modelli scelti = uno qualsiasi di questi
    const modelBtns = [...panel.querySelectorAll<HTMLButtonElement>('[data-model]')];
    modelBtns.forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); filter(); }));
    srcBtns.forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); filter(); }));
    // autonomia, velocità, ruote: etichette; nessuna scelta = tutti, altrimenti solo i monopattini con uno dei valori scelti
    const chipGroups = [...panel.querySelectorAll<HTMLElement>('[data-chips]')];
    const chipBtns = chipGroups.flatMap((g) => [...g.querySelectorAll<HTMLButtonElement>('[data-val]')]);
    chipBtns.forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); filter(); }));

    // Ordina (all'apertura: prezzo più basso); i monopattini senza valore vanno in fondo
    const sort = () => {
      const [key, dir] = sel.value.split('-');
      const sorted = [...cards].sort((a, b) => {
        const x = num(a, key), y = num(b, key);
        if (isNaN(x)) return 1;
        if (isNaN(y)) return -1;
        return dir === 'asc' ? x - y : y - x;
      });
      // prima i nostri, poi il separatore e gli annunci di tutti.ch
      grid.append(...sorted.filter((c) => c.dataset.source !== 'tutti'), ...(sep ? [sep] : []), ...sorted.filter((c) => c.dataset.source === 'tutti'));
    };

    // Filtra: nasconde le card fuori dagli intervalli scelti (senza valore = sempre visibili)
    const filter = () => {
      const limits = ranges.map((r) => {
        const lo = r.querySelector<HTMLInputElement>('[data-lo]')!, hi = r.querySelector<HTMLInputElement>('[data-hi]')!;
        const a = Number(lo.value), b = Number(hi.value);
        r.querySelector('[data-out]')!.textContent = `${show(r.dataset.range!, a)} – ${show(r.dataset.range!, b)}`;
        return [r.dataset.range!, a, b] as const;
      });
      // provenienza: pulsanti "Monopattini.ch" / "tutti.ch" (attivi = mostrati)
      const on = srcBtns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.src);
      const picked = modelBtns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.model!);
      const chosen = chipGroups.map((g) => [g.dataset.chips!, [...g.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"]')].map((b) => Number(b.dataset.val))] as const).filter(([, v]) => v.length);
      let n = 0;
      cards.forEach((c) => {
        const ok = chosen.every(([k, vals]) => vals.includes(num(c, k))) && (!picked.length || (c.dataset.models ?? '').split('|').some((m) => picked.includes(m))) && (!srcBtns.length || on.includes(c.dataset.source!)) && limits.every(([k, a, b]) => { const v = num(c, k); return isNaN(v) || (v >= a && v <= b); });
        c.hidden = !ok;
        if (ok) n++;
      });
      if (sep) sep.hidden = !cards.some((c) => c.dataset.source === 'tutti' && !c.hidden);
      document.querySelector('[data-count]')!.textContent = `${n} monopattin${n === 1 ? 'o' : 'i'}`;
      document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    };

    // Doppio cursore: il minimo non supera il massimo e viceversa
    ranges.forEach((r) => {
      const lo = r.querySelector<HTMLInputElement>('[data-lo]')!, hi = r.querySelector<HTMLInputElement>('[data-hi]')!;
      // i due pallini restano sempre ad almeno un passo di distanza, così non si sovrappongono
      const step = Number(lo.step);
      lo.addEventListener('input', () => { if (Number(lo.value) > Number(hi.value) - step) lo.value = String(Number(hi.value) - step); filter(); });
      hi.addEventListener('input', () => { if (Number(hi.value) < Number(lo.value) + step) hi.value = String(Number(lo.value) + step); filter(); });
    });
    document.querySelectorAll('[data-reset]').forEach((b) => b.addEventListener('click', () => {
      ranges.forEach((r) => {
        const lo = r.querySelector<HTMLInputElement>('[data-lo]')!, hi = r.querySelector<HTMLInputElement>('[data-hi]')!;
        lo.value = lo.min; hi.value = hi.max;
      });
      srcBtns.forEach((s) => s.setAttribute('aria-pressed', 'true'));
      [...modelBtns, ...chipBtns].forEach((m) => m.setAttribute('aria-pressed', 'false'));
      filter();
    }));

    // Telefono: i filtri si aprono con il pulsante "Filtri"
    const toggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]')!;
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    sel.addEventListener('change', sort);
    sort();
    filter();

    // L'elenco è alto almeno quanto la colonna dei filtri (non di più: con pochi risultati la pagina si accorcia)
    const main = grid.closest<HTMLElement>('.shop-main')!;
    const lock = () => { main.style.minHeight = matchMedia('(max-width: 900px)').matches ? '' : `${panel.offsetHeight}px`; };
    lock();
    addEventListener('resize', lock);
  }
</script>
