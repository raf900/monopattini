---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
// Foto dell'hero (slideshow): foto, descrizione, inquadratura (object-position)
import scooterPhoto from '../assets/hero/scooter.jpg';   // Unsplash, Hiboy: https://unsplash.com/photos/qwPdZr8Fa5g
import nottePhoto from '../assets/hero/notte.webp';
const slides = [
  { src: scooterPhoto, alt: 'Un monopattino elettrico parcheggiato al tramonto', pos: '50% 55%' },
  { src: nottePhoto, alt: 'La ruota anteriore di un monopattino elettrico di sera, in città', pos: '50% 88%' },
];
import ScooterCards from '../components/ScooterCards.astro';
import RepairPicker from '../components/RepairPicker.astro';
const services = [
  { href: '/riparazioni', title: 'Ripara', text: 'Riparazioni di qualità nel più breve tempo possibile.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>' },
  { href: '/compra', title: 'Compra', text: 'Usati migliorati, con 6 mesi di garanzia.',
    icon: '<circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M7.5 18h9M6 15.6 9 4M6.5 4h5"/>' },
  { href: '/vendi', title: 'Vendi', text: "Ti facciamo un'offerta onesta per il tuo mezzo.",
    icon: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><circle cx="7" cy="7" r="1.5"/>' },
];
import Steps from '../components/Steps.astro';
import Contacts from '../components/Contacts.astro';
import { wa } from '../data/site.js';
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Specializzati in riparazioni di mezzi elettrici</p>
        <h1>Se va a batteria,<br /><span class="accent">lo sistemiamo.</span></h1>
        <p class="lead">Monopattini, scooter, moto elettriche.<br />Li ripariamo, vendiamo usati e garantiti, compriamo il tuo.<br />Consulenza gratuita, sconti su più riparazioni.</p>
        <ul class="badges">
          <li>✓ Garanzia 6 mesi</li>
          <li>✓ Assistenza 24/7</li>
          <li>✓ Consulenza gratis</li>
        </ul>
      </div>
      <div class="hero-art">
        <div class="hero-photo hero-slides" data-slides>
          {slides.map((sl, i) => (
            <Image src={sl.src} alt={sl.alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 480px"
              loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined}
              class:list={['hero-slide', i === 0 && 'on']} style={`object-position:${sl.pos}`} />
          ))}
          <div class="hero-dots">
            {slides.map((_, i) => <button type="button" aria-label={`Foto ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ripara / Compra / Vendi, come sul volantino -->
  <section class="section services-sec">
    <div class="wrap services">
      {services.map((s) => (
        <a class="card service" href={s.href}>
          <span class="service-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} /></span>
          <span><h3>{s.title}</h3><p>{s.text}</p></span>
        </a>
      ))}
    </div>
  </section>

  <section id="ripara" class="section alt">
    <div class="wrap">
      <p class="eyebrow">Riparazioni</p>
      <h2>Cosa ripariamo</h2>
      <p class="sub">Scegli il tuo mezzo, dicci cosa non va e ti mandiamo un preventivo su WhatsApp.</p>
      <RepairPicker links />
    </div>
  </section>

  <section id="compra" class="section">
    <div class="wrap">
      <p class="eyebrow">Disponibili ora</p>
      <h2>Monopattini in vendita</h2>
      <p class="sub">Ogni monopattino è riparato, migliorato e venduto con 6 mesi di garanzia. Tutte le specifiche e i dati di utilizzo sono disponibili nella scheda di ogni monopattino.</p>
      <ScooterCards onlyAvailable featured teaser />
    </div>
  </section>

  <Steps />

  <section class="section">
    <div class="wrap sell-cta">
      <div>
        <p class="eyebrow">Vendi il tuo monopattino</p>
        <h2>Hai un monopattino che non usi più?</h2>
        <p class="sub">Lo valutiamo e ti facciamo un'offerta onesta, se ti va bene lo compriamo. Guarda quanto paghiamo per ogni modello.</p>
      </div>
      <div class="cta-row">
        <a class="btn" href="/vendi">Quanto vale il mio?</a>
        <a class="btn btn-ghost" href={wa('Ciao! Vorrei vendere il mio monopattino.')}>Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>

  <section id="contatti" class="section alt">
    <div class="wrap">
      <Contacts />
    </div>
  </section>
</Layout>

<script>
  // Slideshow dell'hero: cambia foto ogni 5 s (ferma se l'utente preferisce meno animazioni);
  // i pallini scelgono la foto, e si può scorrere col dito.
  document.querySelectorAll<HTMLElement>('[data-slides]').forEach((box) => {
    const slides = [...box.querySelectorAll<HTMLElement>('.hero-slide')];
    const dots = [...box.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let i = 0, timer = 0;
    const show = (n: number) => {
      slides[i].classList.remove('on'); dots[i].removeAttribute('aria-current');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('on'); dots[i].setAttribute('aria-current', 'true');
    };
    const start = () => {
      clearInterval(timer);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => show(i + 1), 5000);
    };
    dots.forEach((d, n) => d.addEventListener('click', () => { show(n); start(); }));
    let x0: number | null = null;
    box.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    box.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); start(); }
    });
    box.addEventListener('pointercancel', () => { x0 = null; });
    box.addEventListener('dragstart', (e) => e.preventDefault());
    start();
  });
</script>

<style>
  .sell-cta { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; }
  .sell-cta .sub { margin-bottom: 0; }
  .sell-cta .cta-row { margin: 0; }
</style>
