---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
// Foto dell'hero (quadrata, con la scritta "La tua mobilità elettrica, senza pensieri.")
import heroPhoto from '../assets/hero/mobilita.jpg';
import { wa } from '../data/site.js';
const services = [
  { href: '/riparazioni', title: 'Ripara', text: 'Riparazioni di qualità in 24/48 ore.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>' },
  { href: '/compra', title: 'Compra', text: 'Usati migliorati, con 6 mesi di garanzia.',
    icon: '<circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M7.5 18h9M6 15.6 9 4M6.5 4h5"/>' },
  { href: '/noleggia', title: 'Noleggia', text: 'Monopattini controllati e pronti a partire.',
    icon: '<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/>' },
];
import Contacts from '../components/Contacts.astro';
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Specializzati in riparazioni di mezzi elettrici</p>
        <h1>Se va a batteria,<br /><span class="accent">lo sistemiamo.</span></h1>
        <p class="lead lead-gap">Monopattini, scooter, moto elettriche.</p>
        <p class="lead lead-gap lead-join">Ripariamo, vendiamo usati<br class="m-br" /> e garantiti, compriamo il tuo.</p>
        <p class="lead">Consulenza onesta e gratuita,<br class="m-br" /> sconti su più riparazioni.</p>
        <ul class="badges">
          <li>✓ Garanzia 6 mesi</li>
          <li>✓ Prezzi vantaggiosi</li>
          <li>✓ Assistenza via chat</li>
        </ul>
      </div>
      <div class="hero-art">
        <figure class="hero-figure">
          <Image src={heroPhoto} alt="La ruota anteriore di un monopattino elettrico in città" widths={[480, 960]} sizes="(max-width: 900px) 100vw, 480px"
            loading="eager" fetchpriority="high" class="hero-photo hero-photo-full" />
          <!-- scritta a mano sopra la foto (testo vero, non nell'immagine) -->
          <figcaption class="hero-script">La tua mobilità<br />elettrica, senza pensieri.
            <svg viewBox="0 0 200 12" aria-hidden="true"><path d="M3 9 C 60 3, 140 2, 197 5" /></svg>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Ripara / Compra / Vendi, come sul volantino -->
  <section class="section services-sec">
    <div class="wrap services">
      {services.map((s) => (
        <a class="card service" href={s.href}>
          <span class="service-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} /></span>
          <span><h3>{s.title}</h3><p set:html={s.text} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap sell-cta">
      <div>
        <p class="eyebrow">Vendi il tuo monopattino</p>
        <h2>Hai un monopattino che non usi più?</h2>
        <p class="sub">Lo valutiamo e ti facciamo un'offerta onesta, se ti va bene lo compriamo.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-ghost" href={wa('Ciao! Vorrei vendere il mio monopattino.')}>Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>

  <section id="contatti" class="section alt">
    <div class="wrap">
      <Contacts />
    </div>
  </section>
</Layout>

<style>
  /* Vendi il tuo monopattino: tutto centrato */
  .sell-cta { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .sell-cta .sub { margin: 0 auto; }
  .sell-cta .cta-row { margin: 0; justify-content: center; }
</style>
