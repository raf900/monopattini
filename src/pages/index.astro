---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
// Foto dell'hero (Unsplash, Hiboy: https://unsplash.com/photos/qwPdZr8Fa5g)
import heroPhoto from '../assets/hero/scooter.jpg';
import ScooterCards from '../components/ScooterCards.astro';
import RepairPicker from '../components/RepairPicker.astro';
const services = [
  { href: '/riparazioni', title: 'Ripara', text: 'Riparazioni di qualità nel più breve tempo possibile.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>' },
  { href: '/compra', title: 'Compra', text: 'Usati riparati e migliorati, con 6 mesi di garanzia.',
    icon: '<circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M7.5 18h9M6 15.6 9 4M6.5 4h5"/>' },
  { href: '/vendi', title: 'Vendi', text: "Ti facciamo un'offerta onesta per il tuo mezzo.",
    icon: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><circle cx="7" cy="7" r="1.5"/>' },
];
import Steps from '../components/Steps.astro';
import Contacts from '../components/Contacts.astro';
import { wa } from '../data/site.js';
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Riparazione e vendita di mezzi elettrici in Ticino</p>
        <h1>Se va a batteria,<br /><span class="accent">lo sistemiamo.</span></h1>
        <p class="lead">Monopattini, scooter e moto elettriche, hoverboard e monoruota: li ripariamo, vendiamo usati riparati e garantiti e compriamo il tuo. Consulenza gratuita per capire le tue esigenze.</p>
        <div class="cta-row">
          <a class="btn" href="/riparazioni">Ripara</a>
          <a class="btn btn-ghost" href="/compra">Compra</a>
          <a class="btn btn-ghost" href="/vendi">Vendi</a>
        </div>
        <ul class="badges">
          <li>✓ Garanzia 6 mesi</li>
          <li>✓ Assistenza 24/7</li>
          <li>✓ Consulenza gratis</li>
        </ul>
      </div>
      <div class="hero-art">
        <Image src={heroPhoto} alt="Un monopattino elettrico parcheggiato al tramonto" widths={[480, 960]} sizes="(max-width: 900px) 100vw, 480px"
          loading="eager" fetchpriority="high" class="hero-photo" style="object-position:50% 55%" />
      </div>
    </div>
  </section>

  <!-- Ripara / Compra / Vendi, come sul volantino -->
  <section class="section services-sec">
    <div class="wrap services">
      {services.map((s) => (
        <a class="card service" href={s.href}>
          <span class="service-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} /></span>
          <span><h3>{s.title}</h3><p>{s.text}</p></span>
        </a>
      ))}
    </div>
  </section>

  <section id="ripara" class="section alt">
    <div class="wrap">
      <p class="eyebrow">Riparazioni</p>
      <h2>Cosa ripariamo</h2>
      <p class="sub">Scegli il tuo mezzo, dicci cosa non va e ti mandiamo un preventivo su WhatsApp.</p>
      <RepairPicker links />
    </div>
  </section>

  <section id="compra" class="section">
    <div class="wrap">
      <p class="eyebrow">Disponibili ora</p>
      <h2>Monopattini in vendita</h2>
      <p class="sub">Ogni monopattino è riparato, migliorato e venduto con 6 mesi di garanzia. Tutte le specifiche e i dati di utilizzo sono disponibili nella scheda di ogni monopattino.</p>
      <ScooterCards onlyAvailable featured teaser />
    </div>
  </section>

  <Steps />

  <section class="section">
    <div class="wrap sell-cta">
      <div>
        <p class="eyebrow">Vendi il tuo monopattino</p>
        <h2>Hai un monopattino che non usi più?</h2>
        <p class="sub">Lo valutiamo e ti facciamo un'offerta onesta, se ti va bene lo compriamo. Guarda quanto paghiamo per ogni modello.</p>
      </div>
      <div class="cta-row">
        <a class="btn" href="/vendi">Quanto vale il mio?</a>
        <a class="btn btn-ghost" href={wa('Ciao! Vorrei vendere il mio monopattino.')}>Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>

  <section id="contatti" class="section alt">
    <div class="wrap">
      <Contacts />
    </div>
  </section>
</Layout>

<style>
  .sell-cta { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; }
  .sell-cta .sub { margin-bottom: 0; }
  .sell-cta .cta-row { margin: 0; }
</style>
