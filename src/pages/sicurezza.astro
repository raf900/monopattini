---
import Layout from '../layouts/Layout.astro';
import { checks, parents, quiz, rules, situations } from '../data/safety.js';

// Icone delle regole (tratti SVG, viewBox 24×24)
const icons = {
  age: '<circle cx="12" cy="7" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>',
  speed: '<path d="M4 15a8 8 0 1 1 16 0"/><path d="m12 15 4-5"/><path d="M4 19h16"/>',
  road: '<path d="M7 3 4 21M17 3l3 18M12 4v3M12 11v3M12 18v2"/>',
  one: '<circle cx="12" cy="5" r="2.5"/><path d="M12 8v7l-3 6M12 15l3 6M8 11h8"/>',
  light: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"/>',
  helmet: '<path d="M3 15a9 9 0 0 1 18 0v2H3z"/><path d="M12 6v5M3 17l2 3h14l2-3"/>',
  alcohol: '<path d="M8 2h8l-1 9a3 3 0 0 1-6 0z"/><path d="M12 14v6M8 22h8"/><path d="m3 3 18 18"/>',
  check: '<path d="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
};

// Video: link YouTube → riquadro incorporato (senza cookie), file → lettore video
const youtubeId = (url) => url.match(/(?:youtu\.be\/|v=|shorts\/)([\w-]{11})/)?.[1];
---
<Layout
  title="Sicurezza: guidare il monopattino in sicurezza — Monopattini.ch"
  description="Le regole per i monopattini elettrici in Svizzera e come comportarsi nelle situazioni di tutti i giorni, per guidare in sicurezza e rispettare pedoni e automobilisti."
>
  <section class="section page-top">
    <div class="wrap sz-intro">
      <p class="eyebrow">Sicurezza</p>
      <h1 class="page-title">Guida sicuro,<br /><span class="accent">rispetta gli altri.</span></h1>
      <p class="sub">
        Il monopattino è un mezzo fantastico, ma non è un giocattolo. Ogni settimana sentiamo di incidenti causati da chi
        va troppo veloce, sul marciapiede o senza conoscere le regole, spesso ragazzi giovanissimi.
        Vendiamo monopattini ogni giorno: vogliamo anche che chi li guida torni a casa sano e salvo, e che non faccia male a nessuno.
      </p>
      <nav class="sz-jump" aria-label="In questa pagina">
        <a href="#regole">Le regole</a><a href="#situazioni">Situazioni</a><a href="#genitori">Per i genitori</a><a href="#quiz">Quiz</a>
      </nav>
    </div>
  </section>

  <section id="regole" class="section alt">
    <div class="wrap">
      <p class="eyebrow">In Svizzera</p>
      <h2>Le regole da sapere</h2>
      <p class="sub">Valgono per i monopattini elettrici fino a 20 km/h. Per molti aspetti si guida come in bicicletta.</p>
      <div class="sz-rules">
        {rules.map((r) => (
          <div class="card sz-rule">
            <svg class="sz-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[r.icon]} />
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="situazioni" class="section">
    <div class="wrap">
      <p class="eyebrow">Buone maniere su due ruote</p>
      <h2>Come comportarsi</h2>
      <p class="sub">Le situazioni di tutti i giorni, con cosa fare e cosa evitare.</p>
      <div class="sz-situations">
        {situations.map((s, i) => (
          <article class="card sz-sit">
            <div class="sz-video">
              {s.video && youtubeId(s.video) ? (
                <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId(s.video)}`} title={s.title} loading="lazy"
                  allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              ) : s.video ? (
                <video src={`/video/${s.video}`} controls preload="metadata" playsinline></video>
              ) : (
                <div class="sz-video-soon"><span class="sz-play" aria-hidden="true">▶</span>Video in arrivo</div>
              )}
            </div>
            <h3><span class="sz-n">{i + 1}</span>{s.title}</h3>
            <div class="sz-dodont">
              <ul class="sz-do">{s.do.map((t) => <li>{t}</li>)}</ul>
              <ul class="sz-dont">{s.dont.map((t) => <li>{t}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="genitori" class="section alt">
    <div class="wrap sz-two">
      <div>
        <p class="eyebrow">Per i genitori</p>
        <h2>Prima di dargli le chiavi</h2>
        <ul class="sz-list">{parents.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="card">
        <h3>Controllo in 1 minuto, prima di partire</h3>
        <dl class="sz-checks">
          {checks.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <a class="btn" href="/compra">Guarda i monopattini controllati</a>
      </div>
    </div>
  </section>

  <section id="quiz" class="section">
    <div class="wrap">
      <p class="eyebrow">Mettiti alla prova</p>
      <h2>Quiz: sai guidare il monopattino?</h2>
      <div class="sz-quiz" data-quiz>
        {quiz.map((item, qi) => (
          <fieldset class="card sz-q" data-answer={item.answer}>
            <legend><span class="sz-n">{qi + 1}</span>{item.q}</legend>
            <div class="sz-opts">
              {item.options.map((o, oi) => <button type="button" data-opt={oi}>{o}</button>)}
            </div>
            <p class="sz-why" hidden>{item.why}</p>
          </fieldset>
        ))}
        <p class="sz-score" data-score hidden></p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap sz-sources">
      <p>Fonti: <a href="https://www.astra.admin.ch/it/specificita-legate-al-mezzo" rel="noopener" target="_blank">Ufficio federale delle strade (USTRA)</a>,
        <a href="https://www.suva.ch/it-ch/chi-siamo/articoli-e-media/articoli/guida-pratica-agli-scooter-elettrici" rel="noopener" target="_blank">Suva</a>.
        Queste informazioni sono un aiuto e non sostituiscono la legge: in caso di dubbio fanno fede le norme ufficiali.</p>
    </div>
  </section>
</Layout>

<script>
  // Quiz: un tentativo per domanda, poi si mostra la spiegazione; alla fine il punteggio.
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const qs = [...quiz.querySelectorAll<HTMLElement>('.sz-q')];
    const score = quiz.querySelector<HTMLElement>('[data-score]')!;
    let done = 0, right = 0;
    qs.forEach((q) => q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) => b.addEventListener('click', () => {
      if (q.dataset.done) return;
      q.dataset.done = '1';
      const ok = b.dataset.opt === q.dataset.answer;
      b.classList.add(ok ? 'ok' : 'ko');
      q.querySelector(`[data-opt="${q.dataset.answer}"]`)!.classList.add('ok');
      q.querySelector<HTMLElement>('.sz-why')!.hidden = false;
      done++; if (ok) right++;
      if (done === qs.length) {
        score.hidden = false;
        score.textContent = right === qs.length ? `${right}/${qs.length}: perfetto, sei un pilota modello! 🏆`
          : `${right}/${qs.length}: ripassa le regole qui sopra e riprova la prossima volta.`;
      }
    })));
  });
</script>

<style>
  .sz-intro .sub { max-width: 46em; }
  .sz-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .sz-jump a { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; color: var(--text); text-decoration: none; font-size: .9rem; }
  .sz-jump a:hover { border-color: var(--accent); color: var(--accent); }

  .sz-rules { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .sz-rule h3 { font-size: 1.05rem; margin: 10px 0 6px; }
  .sz-rule p { color: var(--muted); font-size: .92rem; margin: 0; }
  .sz-ico { width: 34px; height: 34px; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .sz-situations { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .sz-sit { display: flex; flex-direction: column; gap: 12px; }
  .sz-sit h3 { display: flex; align-items: center; gap: 10px; font-size: 1.1rem; margin: 4px 0 0; }
  .sz-n { display: inline-grid; place-items: center; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font: 800 .85rem var(--display); }
  .sz-video { aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: var(--bg-alt); border: 1px solid var(--line); }
  .sz-video :is(iframe, video) { width: 100%; height: 100%; border: 0; display: block; }
  .sz-video-soon { height: 100%; display: grid; place-items: center; align-content: center; gap: 8px; color: var(--muted); font-size: .9rem; }
  .sz-play { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 1.2rem; padding-left: 4px; }
  .sz-dodont { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .sz-dodont ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; align-content: start; font-size: .92rem; }
  .sz-dodont li { padding-left: 26px; position: relative; text-align: left; }
  .sz-dodont li::before { position: absolute; left: 0; top: 0; font-weight: 800; }
  .sz-do li::before { content: '✓'; color: #22a55a; }
  .sz-dont li::before { content: '✕'; color: #e5484d; }

  .sz-two { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: start; }
  .sz-list { padding-left: 1.2em; display: grid; gap: 10px; text-align: left; }
  .sz-checks { margin: 0 0 20px; display: grid; gap: 10px; text-align: left; }
  .sz-checks div { display: grid; grid-template-columns: 120px 1fr; gap: 10px; }
  .sz-checks dt { font-weight: 700; }
  .sz-checks dd { margin: 0; color: var(--muted); font-size: .92rem; }

  .sz-quiz { display: grid; gap: 14px; max-width: 760px; margin-top: 1.5rem; }
  .sz-q { margin: 0; border: 1px solid var(--line); text-align: left; }
  .sz-q legend { display: flex; align-items: center; gap: 10px; font-weight: 700; padding: 0; float: left; width: 100%; margin-bottom: 12px; }
  .sz-opts { clear: both; display: flex; flex-wrap: wrap; gap: 8px; }
  .sz-opts button { font: inherit; color: var(--text); background: none; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; cursor: pointer; }
  .sz-opts button:hover { border-color: var(--accent); }
  .sz-opts button.ok { background: #22a55a; border-color: #22a55a; color: #fff; }
  .sz-opts button.ko { background: #e5484d; border-color: #e5484d; color: #fff; }
  .sz-why { margin: 12px 0 0; color: var(--muted); font-size: .92rem; }
  .sz-score { font: 800 1.2rem var(--display); margin: 8px 0 0; }

  .sz-sources p { color: var(--muted); font-size: .85rem; margin: 0; }
  .sz-sources a { color: var(--accent); }

  @media (max-width: 900px) {
    .sz-rules { grid-template-columns: 1fr 1fr; }
    .sz-situations, .sz-two { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .sz-jump { justify-content: center; }
    .sz-rules { grid-template-columns: 1fr; }
    .sz-dodont { grid-template-columns: 1fr; }
    .sz-checks div { grid-template-columns: 1fr; gap: 2px; }
    .sz-opts { justify-content: center; }
  }
</style>
