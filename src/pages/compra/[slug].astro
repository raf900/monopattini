---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ScooterMark from '../../components/ScooterMark.astro';
import ScooterCards from '../../components/ScooterCards.astro';
import { scooters, statusLabel, wa, chf } from '../../data/site.js';
import { photo } from '../../data/photos.js';

export function getStaticPaths() {
  return scooters.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const photos = (s.photos ?? []).map(photo).filter(Boolean);
// Le foto .png/.webp sono scontornate su fondo bianco: solo quelle si fondono con lo sfondo (multiply)
const cutout = /\.(png|webp)$/.test(s.photos?.[0] ?? '');

// Video: link YouTube → embed senza cookie; altrimenti file in public/.
const yt = s.video?.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([\w-]{11})/)?.[1];

// Velocità: limite legale in evidenza, sotto più piccola quella su strade private
const speedHtml = s.velocita
  ? `${s.velocita} km/h` + (s.velocitaMax ? ` <small class="pd-private">(${s.velocitaMax} strade private)</small>` : '')
  : '';

const quick = [
  s.year && ['Anno produzione', s.year],
  s.km != null && ['Chilometri percorsi', `${s.km.toLocaleString('de-CH')} km`],
  s.velocita && ['Velocità', speedHtml],
].filter(Boolean);

// Diagnosi letta dal monopattino (solo i campi presenti)
const d = s.diagnosi ?? {};
const diag = [
  d.saluteBatteria && ['Salute batteria', `${d.saluteBatteria}%`],
  d.autonomia && ['Autonomia', d.autonomia],
  d.dataProduzione && ['Data di produzione', d.dataProduzione],
  d.dataBatteria && ['Data batteria', d.dataBatteria],
  d.cicliInteri != null && ['Cicli di carica completi', d.cicliInteri],
  d.cicliParziali != null && ['Cicli di carica parziali', d.cicliParziali],
  d.tempoGuida && ['Tempo di guida', d.tempoGuida],
  d.tempoAcceso && ['Tempo acceso', d.tempoAcceso],
  d.tempoUtilizzo && ['Tempo di utilizzo', d.tempoUtilizzo],
  d.chip && ['Controller', d.chip],
].filter(Boolean);
const scoreRows = s.punteggio ? [['Batteria', s.punteggio.batteria], ['Freni', s.punteggio.freni], ['Gomme', s.punteggio.gomme], ['Estetica', s.punteggio.estetica], ['Elettronica', s.punteggio.elettronica]].filter(([, v]) => v != null) : [];

// Altri monopattini con la stessa struttura
const similar = scooters.filter((o) => o.slug !== s.slug && o.famiglia && o.famiglia === s.famiglia);

const available = s.status !== 'esaurito';
const ask = available
  ? wa(`Ciao! Sono interessato al ${s.model} (${chf(s.price)}). È ancora disponibile?`)
  : wa(`Ciao! Avvisatemi se arriva un altro ${s.model}.`);
---
<Layout
  title={`${s.model} usato — ${chf(s.price)} | Monopattini.ch`}
  description={`${s.model} usato e controllato: ${chf(s.price)}, ${s.km} km, batteria al ${s.diagnosi?.saluteBatteria ?? '–'}%. Testato e migliorato, 6 mesi di garanzia.`}
>
  <section class="section page-top">
    <div class="wrap">
      <nav class="crumbs" aria-label="Percorso">
        <a href="/compra">Compra</a><span aria-hidden="true">›</span><span>{s.model}</span>
      </nav>

      <div class="pd-top">
        <div class="pd-gallery" data-gallery>
          <div class:list={['pd-main', cutout && 'cutout']}>
            {photos.length
              ? photos.map((p, i) => (
                  <Image src={p} alt={`${s.model} — foto ${i + 1}`} widths={[480, 960]} sizes="(max-width: 900px) 92vw, 560px"
                    loading={i === 0 ? 'eager' : 'lazy'} data-photo={i} aria-hidden={i === 0 ? undefined : 'true'} />
                ))
              : <ScooterMark />}
            {s.status && s.status !== 'disponibile' && <span class={`status status-${s.status}`}>{statusLabel[s.status]}</span>}
          </div>
          {s.photoCredit && <p class="pd-credit">{s.photoCredit}</p>}
          {photos.length > 1 && (
            <div class="pd-thumbs">
              {photos.map((p, i) => (
                <button type="button" data-thumb={i} aria-pressed={String(i === 0)} aria-label={`Foto ${i + 1}`}>
                  <Image src={p} alt="" widths={[160]} sizes="80px" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="pd-info">
          <p class="eyebrow">Usato revisionato</p>
          <h1 class="page-title">{s.model}</h1>
          <p class="pd-price">{chf(s.price)}</p>
          <dl class="pd-quick">
            {quick.map(([k, v]) => <div class={k === 'Velocità' ? 'pd-wide' : undefined}><dt set:html={k.replace(' ', ' <br />')} /><dd set:html={String(v)} /></div>)}
          </dl>
          <div class="cta-row">
            <a class="btn" href={ask}>{available ? 'Chiedi info su WhatsApp' : 'Avvisami se arriva'}</a>
          </div>
          <p class="pd-note"><span>✓ Controllato e revisionato</span><i> · </i><span>✓ Testato e migliorato</span><i> · </i><span>✓ 6 mesi di garanzia</span></p>
          {s.punteggio && (
            <a class="pd-lab" href="#valutazione" aria-label={`Punteggio ${s.punteggio.totale} su 10: vedi la valutazione`}>
              <span class="pd-lab-name"><ScooterMark class="pd-lab-mark" />SCORE</span>
              <span class="pd-lab-circle"><b>{s.punteggio.totale.toLocaleString('it-CH')}</b><small>/10</small></span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap pd-body">

      <!-- Diagnosi e scheda tecnica affiancate -->
      <div class="pd-tables">
        {diag.length > 0 && (
          <div class="card pd-specs">
            <h2>Diagnosi</h2>
            <p class="pd-diag-note">Dati letti direttamente dal monopattino.</p>
            <table>{diag.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</table>
          </div>
        )}
        {s.specs?.length > 0 && (
          <div class="card pd-specs">
            <h2>Scheda tecnica</h2>
            <p class="pd-diag-note">Dati del produttore.</p>
            <table>
              {s.velocita && <tr><th>Velocità massima</th><td class="pd-nowrap" set:html={speedHtml} /></tr>}
              {s.specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
            </table>
          </div>
        )}
      </div>

      {s.punteggio && (
        <div class="card pd-score" id="valutazione">
          <div class="pd-score-total"><b>{s.punteggio.totale.toLocaleString('it-CH')}</b><span>/10</span></div>
          <div class="pd-score-bars">
            <h2>Valutazione</h2>
            <ul>{scoreRows.map(([k, v]) => <li><span>{k}</span><i style={`--v:${v * 10}%`}></i><b>{v}</b></li>)}</ul>
          </div>
        </div>
      )}

      <div class="pd-lists">
        {s.ricambi?.length > 0 && (
          <div>
            <h3 class="pd-h3">Ricambi nuovi montati</h3>
            <ul class="pd-checks pd-parts">{s.ricambi.map(([n, p]) => <li>{n}{p != null && <span>{chf(p)}</span>}</li>)}</ul>
          </div>
        )}
        {s.work?.length > 0 && (
          <div>
            <h3 class="pd-h3">Revisione effettuata</h3>
            <ul class="pd-checks">{s.work.map((w) => <li>{w}</li>)}</ul>
          </div>
        )}
        {s.included?.length > 0 && (
          <div>
            <h3 class="pd-h3">Incluso</h3>
            <ul class="pd-checks">{s.included.map((w) => <li>{w}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {s.video && (
    <section class="section">
      <div class="wrap">
        <h2>Video</h2>
        <div class="pd-video">
          {yt
            ? <iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={`Video ${s.model}`} loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            : <video src={s.video} controls preload="metadata" playsinline></video>}
        </div>
      </div>
    </section>
  )}

  {similar.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Altri monopattini</h2>
        <ScooterCards exclude={s.slug} famiglia={s.famiglia} />
      </div>
    </section>
  )}
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const show = (i: string) => {
      g.querySelectorAll<HTMLElement>('[data-photo]').forEach((el) => el.toggleAttribute('aria-hidden', el.dataset.photo !== i));
      g.querySelectorAll<HTMLElement>('[data-thumb]').forEach((el) => el.setAttribute('aria-pressed', String(el.dataset.thumb === i)));
    };
    g.querySelectorAll<HTMLElement>('[data-thumb]').forEach((b) => b.addEventListener('click', () => show(b.dataset.thumb!)));
  });
</script>

<style>
  .pd-side { display: grid; gap: 20px; align-content: start; }
  .pd-diag-note { color: var(--muted); font-size: .85rem; margin: -6px 0 10px; }
  .pd-parts li { display: flex; justify-content: space-between; gap: 12px; }
  .pd-parts span { color: var(--muted); }
  .pd-score { display: flex; gap: 32px; align-items: center; }
  .pd-score-bars { flex: 1; max-width: 520px; }
  .pd-score-total { display: grid; place-items: center; align-content: center; flex-shrink: 0; width: 110px; height: 110px; border-radius: 50%; border: 6px solid var(--accent); }
  .pd-score-total b { font: 800 2.2rem/1 var(--display); color: var(--accent); }
  .pd-score-total span { color: var(--muted); font-size: .85rem; }
  .pd-score h2 { font-size: 1.3rem; margin: 0 0 12px; }
  .pd-score ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pd-score li { display: grid; grid-template-columns: 90px 1fr 28px; align-items: center; gap: 10px; font-size: .9rem; }
  .pd-score i { height: 6px; border-radius: 999px; background: linear-gradient(90deg, var(--accent) var(--v), var(--line) var(--v)); }
  .pd-score li b { text-align: right; }
  @media (max-width: 600px) { .pd-score { flex-direction: column; } }
  .crumbs { display: flex; gap: 8px; font-size: .9rem; color: var(--muted); margin-bottom: 24px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  .pd-top { display: grid; grid-template-columns: minmax(0, 506px) 1fr; gap: 48px; align-items: start; }
  .pd-main { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); background: radial-gradient(80% 70% at 50% 45%, #fff, #e3e9f2); }
  .pd-main :global(img) { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: contain; padding: 24px; transition: opacity .25s; }
  .pd-main.cutout :global(img) { mix-blend-mode: multiply; }
  .pd-main :global(img[aria-hidden]) { opacity: 0; visibility: hidden; }
  .pd-main :global(svg) { grid-area: 1 / 1; width: 60%; margin: auto; color: #5d6f8f; }
  .pd-thumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .pd-thumbs button { width: 76px; height: 76px; padding: 6px; border-radius: 10px; border: 2px solid var(--line); background: #eef2f8; cursor: pointer; }
  .pd-thumbs button[aria-pressed='true'] { border-color: var(--accent); }
  .pd-thumbs :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .pd-info { max-width: 460px; text-align: center; }   /* titolo, prezzo, box e pulsante centrati sulla stessa colonna */
  /* anteprima del punteggio sotto il pulsante: logo "monopattino + SCORE" e cerchio con il voto */
  .pd-lab { display: inline-flex; align-items: center; gap: 14px; margin-top: 18px; padding: 8px 12px 8px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--text); text-decoration: none; }
  .pd-lab:hover { border-color: var(--accent); }
  .pd-lab-name { display: flex; align-items: center; gap: 4px; font: 800 .85rem var(--display); letter-spacing: .04em; }
  .pd-lab-name b { color: var(--accent); }
  .pd-lab-name :global(.pd-lab-mark) { height: 16px; width: auto; transform: scaleX(-1); --sm-color: var(--text); }
  .pd-lab-circle { display: grid; place-items: center; align-content: center; width: 54px; height: 54px; border-radius: 50%; border: 4px solid var(--accent); line-height: 1; }
  .pd-lab-circle b { font: 800 1.05rem var(--display); color: var(--accent); }
  .pd-lab-circle small { font-size: .6rem; color: var(--muted); }
  .pd-score { scroll-margin-top: 90px; }
  .pd-info .cta-row { max-width: 460px; justify-content: center; }   /* pulsante centrato sotto i tre box */
  .pd-info :global(.page-title) { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .pd-price { font-family: var(--display); font-weight: 700; font-size: 1.6rem; color: var(--accent); margin: 0 0 16px; }
  /* statistiche: tutte su una riga; se non ci stanno vanno una sotto l'altra */
  .pd-quick { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 8px; max-width: 460px; }
  /* box uguali, contenuto centrato in larghezza e altezza */
  .pd-quick div { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; }
  .pd-quick dt { font-size: .72rem; color: var(--muted); line-height: 1.15; }
  .pd-quick dd { margin: 2px 0 0; font-weight: 600; font-size: .92rem; white-space: nowrap; }
  .pd-quick > div { min-width: 0; }
  :global(.pd-private) { display: block; font-size: .72em; font-weight: 400; color: var(--muted); margin-top: 1px; }   /* sotto la velocità legale */
  .pd-nowrap { white-space: nowrap; }
  .pd-note { color: var(--muted); font-size: .82rem; margin: 0; white-space: nowrap; }
  .pd-note i { font-style: normal; }

  .pd-body { display: grid; gap: 28px; }
  .pd-tables { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .pd-lists { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: start; }
  .pd-lists .pd-h3 { margin-top: 0; }
  .pd-credit { color: var(--muted); font-size: .75rem; margin: 6px 0 0; }
  .pd-text { color: var(--muted); font-size: 1.05rem; max-width: 38em; }
  .pd-h3 { margin-top: 1.6rem; }
  .pd-checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .pd-checks li::before { content: '✓'; color: var(--accent); font-weight: 700; margin-right: 10px; }
  .pd-specs:hover { transform: none; }
  .pd-specs table { width: 100%; border-collapse: collapse; }
  .pd-specs th, .pd-specs td { padding: 11px 0; border-bottom: 1px solid var(--line); text-align: left; font-weight: 500; }
  .pd-specs td { text-align: right; color: var(--muted); }
  .pd-specs tr:last-child > * { border-bottom: 0; }

  .pd-video { aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #000; margin-top: 1rem; }
  .pd-video iframe, .pd-video video { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 900px) {
    .pd-top, .pd-tables, .pd-lists { grid-template-columns: 1fr; gap: 24px; }
    .pd-gallery { width: 100%; max-width: 506px; margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .crumbs, .pd-thumbs { justify-content: center; }
    .pd-checks { justify-items: center; }
    .pd-specs th { text-align: left; }
    .pd-info { margin-inline: auto; }
    /* telefono: una garanzia per riga */
    .pd-note span { display: block; }
    .pd-lab { align-self: center; }   /* telefono: non a tutta larghezza */
    .pd-note i { display: none; }
    .pd-quick :global(dt br) { display: none; }   /* telefono: etichetta su una riga */
    .pd-quick { grid-template-columns: minmax(0, 240px); justify-content: center; margin-inline: auto; }   /* telefono: una sotto l'altra, strette e centrate */
    /* telefono: titolo e prezzo, poi le foto, poi statistiche e pulsante */
    .pd-top { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
    .pd-info { display: contents; }
    .pd-info > * { order: 3; }
    .pd-info > :global(.eyebrow), .pd-info > :global(.page-title), .pd-info > .pd-price { order: 1; }
    .pd-gallery { order: 2; margin-bottom: 20px; }
  }
</style>
